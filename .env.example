# Public Supabase project URL and anonymous API key (used by Auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database access. Use the same project URL as above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after applying the product-tier migration in Supabase.
PLAINPAGE_PRODUCT_TIERS=false

# Optional transactional share/review email (separate from Supabase Auth email).
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=

# Optional monitoring and aggregate analytics.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
PLAINPAGE_ANALYTICS=false

# Optional Clarity suggestions; never expose the API key to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=
